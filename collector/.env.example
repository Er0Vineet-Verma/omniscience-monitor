# Copy to .env and fill in. The collector fails fast at startup if any are missing.
# Generate the agent token with e.g.:  head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'
MONITOR_AGENT_TOKEN=
# IMS service account used by the incident bridge (create it as an ADMIN via an existing admin).
IMS_MONITOR_EMAIL=monitor@ims.com
IMS_MONITOR_PASSWORD=
